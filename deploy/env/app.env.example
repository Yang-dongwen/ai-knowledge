# =============================================================================
# auto-exchange 环境变量模板（可提交）
# -----------------------------------------------------------------------------
# 用法:
#   1) 复制为 deploy/env/app.env（已 gitignore），填入真实值
#   2) 本机同步到服务器: powershell -File deploy/aws/sync-env.ps1
#   3) 日常发版: powershell -File deploy/aws/deploy.ps1  或 GitHub Actions Deploy EC2
# 切勿把含真实密钥的 app.env 提交到 GitHub
# =============================================================================

# ---------- 云端 MySQL（AWS RDS）----------
SPRING_DATASOURCE_URL=jdbc:mysql://YOUR_RDS_ENDPOINT:3306/okx_bot?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=true&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=

# init-rds.sh 用（可与上面一致）
RDS_HOST=YOUR_RDS_ENDPOINT
RDS_PORT=3306
RDS_DATABASE=okx_bot
DB_USER=admin
DB_PASSWORD=

# ---------- 认证 / JWT ----------
# openssl rand -base64 48  （生产必填，≥32 字节随机串）
AUTH_JWT_SECRET=
# 邮件：console | agentmail | smtp
# 生产必须：console-mode=false + provider=agentmail（或 smtp）+ 真实密钥
AUTH_MAIL_PROVIDER=agentmail
AUTH_MAIL_CONSOLE_MODE=false
AUTH_MAIL_FROM=noreply@example.com
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
AGENTMAIL_BASE_URL=https://api.agentmail.to
# 本机 Clash 等：AGENTMAIL_PROXY_HOST=127.0.0.1  AGENTMAIL_PROXY_PORT=7897
AGENTMAIL_PROXY_HOST=
AGENTMAIL_PROXY_PORT=0
AGENTMAIL_PROXY_TYPE=HTTP
# 首次 bootstrap 后务必改为 false；生产禁止默认弱口令
AUTH_ADMIN_SEED_ENABLED=false
AUTH_ADMIN_EMAIL=admin@okx-bot.local
AUTH_ADMIN_PASSWORD=

# ---------- 微信小程序登录（公众平台 → 开发设置）----------
# 生产：true + 填齐 AppId/Secret；禁止 mock
# 本地无密钥：WX_MINI_ENABLED=false 且 WX_MINI_MOCK=true（显式 mock）
WX_MINI_ENABLED=true
WX_MINI_MOCK=false
WX_MINI_APP_ID=
WX_MINI_APP_SECRET=

# ---------- PC OAuth：Google / GitHub（JustAuth）----------
# 本地联调可 AUTH_OAUTH_MOCK=true（不访问外网）；生产务必 false（启动期会校验）
AUTH_OAUTH_MOCK=false
# 禁止按邮箱自动绑定已有账号（默认 false，防账号接管）
AUTH_OAUTH_AUTO_LINK_BY_EMAIL=false
AUTH_OAUTH_FRONTEND_BASE_URL=https://dwcode.cloud
AUTH_OAUTH_CALLBACK_BASE_URL=https://dwcode.cloud
AUTH_OAUTH_TICKET_TTL_SECONDS=60
# Google Cloud Console → OAuth 客户端（Web）
# 授权重定向 URI: {CALLBACK}/api/auth/oauth/google/callback
AUTH_OAUTH_GOOGLE_ENABLED=false
AUTH_OAUTH_GOOGLE_CLIENT_ID=
AUTH_OAUTH_GOOGLE_CLIENT_SECRET=
# GitHub → Settings → Developer settings → OAuth Apps
# Authorization callback URL: {CALLBACK}/api/auth/oauth/github/callback
AUTH_OAUTH_GITHUB_ENABLED=false
AUTH_OAUTH_GITHUB_CLIENT_ID=
AUTH_OAUTH_GITHUB_CLIENT_SECRET=

# ---------- 支付 ----------
# 生产必须 false；true 时登录用户可 mock 履约
PAY_MOCK_ENABLED=false
# 支付宝（未进件保持 false）
PAY_ALIPAY_ENABLED=false
# PAY_ALIPAY_APP_ID=
# PAY_ALIPAY_PRIVATE_KEY=
# PAY_ALIPAY_PUBLIC_KEY=

# ---------- 对外地址 ----------
# 主入口: https://dwcode.cloud （Caddy 80/443）
# 备用: http://dwcode.cloud:8088
PAY_PUBLIC_BASE_URL=https://dwcode.cloud
WEB_HOST_PORT=8088

# ---------- AI 供应商（按需填写）----------
AI_DEFAULT_PROVIDER=nvidia
AI_NVIDIA_API_KEY=
AI_OPENAI_API_KEY=
AI_DEEPSEEK_API_KEY=

# ---------- Cloudflare R2 ----------
STORAGE_PROVIDER=r2
# R2 对象前缀：EC2 用 ec2，本地用 local（勿填 dev）
STORAGE_ENV_PREFIX=ec2
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=

# ---------- 支付（默认关闭）----------
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SERVER_URL=https://openapi.alipay.com/gateway.do

# ---------- 视频 / 渲染（可选）----------
VIDEO_YT_DLP_PATH=yt-dlp
VIDEO_FFMPEG_PATH=ffmpeg
VIDEO_COOKIES_FILE=
WHISPER_MODEL=small
AIGEN_RENDER_TOKEN=

# ---------- Halo 博客（可选；compose --profile blog）----------
# DNS: blog.dwcode.cloud A → 现网 IP
# 首次打开 https://blog.dwcode.cloud/console 初始化后，在个人中心建 PAT
HALO_ENABLED=false
HALO_PAT=
HALO_PUBLIC_BASE_URL=https://blog.dwcode.cloud
HALO_R2DBC_URL=r2dbc:pool:mysql://YOUR_RDS_ENDPOINT:3306/halo
HALO_DB_USERNAME=
HALO_DB_PASSWORD=
HALO_DATABASE=halo
HALO_JVM_OPTS="-Xms128m -Xmx256m"
HALO_ADMIN_USERNAME=admin
HALO_ADMIN_PASSWORD=
HALO_ADMIN_EMAIL=admin@example.com
HALO_SITE_TITLE=Blog

# ---------- JVM ----------
JAVA_OPTS=-Xmx640m

# ---------- 宿主机数据根 ----------
HOST_DATA_ROOT=/data/auto-exchange
