# =============================================================================
# auto-exchange 环境变量清单（可提交仓库）
# -----------------------------------------------------------------------------
# 用法：
#   1) 复制为 deploy/app.env（已 gitignore），填入真实值，仅本机/服务器保留
#   2) 服务器：/opt/auto-exchange/app.env 或仓库旁 deploy/app.env
#   3) Docker：docker compose --env-file deploy/app.env ...
#   4) 本地 IDE：Run Configuration → Environment variables 从该文件导入
# 切勿把含真实密钥的 app.env 提交到 GitHub。
# =============================================================================

# ---------- 云端 MySQL（AWS RDS）----------
SPRING_DATASOURCE_URL=jdbc:mysql://database-1.cfcs8e8a27ef.ap-south-1.rds.amazonaws.com:3306/okx_bot?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=true&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=

# init-rds.sh 用（可与上面一致）
RDS_HOST=database-1.cfcs8e8a27ef.ap-south-1.rds.amazonaws.com
RDS_PORT=3306
RDS_DATABASE=okx_bot
DB_USER=admin
DB_PASSWORD=

# ---------- 认证 / JWT ----------
# openssl rand -base64 48
AUTH_JWT_SECRET=
AUTH_MAIL_CONSOLE_MODE=true
AUTH_MAIL_FROM=noreply@example.com
AUTH_ADMIN_SEED_ENABLED=true
AUTH_ADMIN_EMAIL=admin@okx-bot.local
AUTH_ADMIN_PASSWORD=

# ---------- 对外地址（无域名填 http://公网IP:8088）----------
PAY_PUBLIC_BASE_URL=http://127.0.0.1:8088
WEB_HOST_PORT=8088

# ---------- AI 供应商（按需填写）----------
AI_DEFAULT_PROVIDER=nvidia
AI_NVIDIA_API_KEY=
AI_OPENAI_API_KEY=
AI_DEEPSEEK_API_KEY=

# ---------- Cloudflare R2 ----------
STORAGE_PROVIDER=r2
STORAGE_ENV_PREFIX=prod
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=

# ---------- 支付（默认关）----------
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SERVER_URL=https://openapi.alipay.com/gateway.do

# ---------- 视频 / 渲染（可选）----------
VIDEO_YT_DLP_PATH=yt-dlp
VIDEO_FFMPEG_PATH=ffmpeg
VIDEO_COOKIES_FILE=
WHISPER_MODEL=small
AIGEN_RENDER_TOKEN=

# ---------- JVM ----------
JAVA_OPTS=-Xmx640m
