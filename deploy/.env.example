# 复制为 deploy/.env 后填写（不要提交 .env）
# cp deploy/.env.example deploy/.env

# ---------- AWS RDS MySQL ----------
# 终端节点在 RDS 控制台 → Connectivity → Endpoint
# 请写成完整字面量（容器内不会二次展开 ${}）
# 示例 Endpoint: mydb.xxxxx.ap-northeast-1.rds.amazonaws.com
SPRING_DATASOURCE_URL=jdbc:mysql://your-db.xxxxx.region.rds.amazonaws.com:3306/okx_bot?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=true&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=okx_bot
SPRING_DATASOURCE_PASSWORD=change-me-strong-password

# 仅给 init-rds.sh 用（可选，与上面保持一致）
RDS_HOST=your-db.xxxxx.region.rds.amazonaws.com
RDS_PORT=3306
RDS_DATABASE=okx_bot
DB_USER=okx_bot
DB_PASSWORD=change-me-strong-password

# ---------- 应用密钥 ----------
# 至少 32 字节随机串，例如: openssl rand -base64 48
AUTH_JWT_SECRET=replace-with-long-random-secret-at-least-32-bytes
AUTH_ADMIN_SEED_ENABLED=true
AUTH_ADMIN_EMAIL=admin@okx-bot.local
AUTH_ADMIN_PASSWORD=Admin@ChangeMe
AUTH_MAIL_CONSOLE_MODE=true

# 无域名：填 EC2 弹性公网 IP，例如 http://54.x.x.x
PAY_PUBLIC_BASE_URL=http://YOUR_EC2_PUBLIC_IP

# ---------- AI（至少填一个会用的）----------
AI_DEFAULT_PROVIDER=nvidia
AI_NVIDIA_API_KEY=
AI_OPENAI_API_KEY=
AI_DEEPSEEK_API_KEY=

# ---------- Cloudflare R2（对象存储；可先空，则相关上传会失败）----------
STORAGE_PROVIDER=r2
STORAGE_ENV_PREFIX=prod
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=

# ---------- 可选 ----------
WHISPER_MODEL=small
AIGEN_RENDER_TOKEN=
VIDEO_COOKIES_FILE=
JAVA_OPTS=-Xms512m -Xmx1536m
