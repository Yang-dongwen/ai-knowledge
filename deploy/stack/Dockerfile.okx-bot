# syntax=docker/dockerfile:1
# 多阶段：Maven 打包 → JRE 运行（含 yt-dlp / ffmpeg / edge-tts）

FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /src
COPY okx-bot/pom.xml okx-bot/pom.xml
WORKDIR /src/okx-bot
RUN mvn -B -q -DskipTests dependency:go-offline || true
COPY okx-bot/ /src/okx-bot/
RUN mvn -B -DskipTests package \
    && cp target/okx-bot-*.jar /src/app.jar

FROM eclipse-temurin:17-jre-jammy
RUN apt-get update && apt-get install -y --no-install-recommends \
      ffmpeg \
      python3 \
      python3-pip \
      curl \
      ca-certificates \
    && pip3 install --no-cache-dir --break-system-packages yt-dlp edge-tts \
    || pip3 install --no-cache-dir yt-dlp edge-tts \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=build /src/app.jar /app/app.jar
# application-ec2.yml 已打进 jar（变量占位）；真实密钥由容器环境变量（app.env）注入
RUN mkdir -p \
      /app/data/video \
      /app/data/aigen \
      /app/data/imggen \
      /app/data/_scratch \
      /app/data/_objects \
      /app/logs

ENV SPRING_PROFILES_ACTIVE=ec2 \
    JAVA_OPTS="-Xms512m -Xmx1536m"


EXPOSE 8080
# 无 actuator 时：进程监听 8080 即视为存活（401/404 也算起来了）
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=5 \
  CMD curl -s -o /dev/null -w "%{http_code}" http://127.0.0.1:8080/ | grep -qE '^[2345]' || exit 1

ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/app.jar"]
