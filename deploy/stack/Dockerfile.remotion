# syntax=docker/dockerfile:1
# Remotion 渲染服务（需 Chromium 依赖；与 okx-bot 共享 /app/data）

FROM node:20-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      ffmpeg \
      ca-certificates \
      fonts-liberation \
      fonts-noto-cjk \
      libasound2 \
      libatk-bridge2.0-0 \
      libatk1.0-0 \
      libcups2 \
      libdbus-1-3 \
      libdrm2 \
      libgbm1 \
      libgtk-3-0 \
      libnspr4 \
      libnss3 \
      libx11-xcb1 \
      libxcomposite1 \
      libxdamage1 \
      libxrandr2 \
      libxkbcommon0 \
      libxfixes3 \
      libpango-1.0-0 \
      libcairo2 \
      xdg-utils \
      curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY aigen-remotion/package.json aigen-remotion/package-lock.json ./
# 构建期 bundle 需要 devDependencies（typescript 等）
RUN npm ci
COPY aigen-remotion/ ./

# 预下载 Remotion Chrome（构建期；失败时运行期再试）
RUN npx remotion browser ensure || true

ENV HOST=0.0.0.0 \
    PORT=3100 \
    ALLOWED_WORK_ROOT=/app/data \
    MAX_CONCURRENT_RENDERS=1

EXPOSE 3100
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=5 \
  CMD curl -fsS http://127.0.0.1:3100/health || exit 1

CMD ["node", "server/index.mjs"]
