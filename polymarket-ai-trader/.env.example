# ===========================================================================
# Polymarket AI 自动交易脚本配置文件
# 复制本文件为 .env 后填入真实值
# ===========================================================================

# =========================
# Polymarket 钱包配置
# =========================

# 你的以太坊钱包私钥（Polygon 链 EOA）
# 获取方式：MetaMask → 账户详情 → 导出私钥
# 格式：0x 开头的 64 位十六进制字符串
# 安全提示：建议使用专门的交易钱包，不要用主钱包
POLYMARKET_PRIVATE_KEY=0xac8f2e283176a6f0a25108586017285ac860fda653a507e45eb164d2905e2ce7

# 你的 Funder 地址（资金来源地址）
# - 新用户（Deposit Wallet 模式）：通过 SDK 的 derive_deposit_wallet_address() 获取
# - 老用户（Proxy Wallet 模式）：Polymarket 网页端 Profile 页面可以看到
# - 这个地址是实际持有 pUSD 并用于下单的合约钱包地址，不是你的 EOA 地址
POLYMARKET_FUNDER_ADDRESS=0xa62d47973070375cafD9556F7EeaDD75D937A2E9

# 签名类型，决定订单签名的验证方式
# 0 = EOA（直接用私钥签名，老用户）
# 1 = POLY_GNOSIS_SAFE（Safe 多签钱包）
# 2 = POLY_PROXY（Proxy Wallet，老版 Polymarket 账户）
# 3 = POLY_1271（Deposit Wallet，新用户推荐）
# 新注册 API 用户选 3，已有 Proxy Wallet 的老用户选 2
POLYMARKET_SIGNATURE_TYPE=3

# CLOB API 认证凭证
# 通过 SDK 从私钥派生：client.create_or_derive_api_creds()
# 返回 apiKey / secret / passphrase 三个值
# 首次使用需要运行一次派生脚本获取这三个值
CLOB_API_KEY=019e33ea-0abd-738d-9ad9-cc0032921004
CLOB_SECRET=UqIw4HBHTcW-OXTak0GvPnb8Kk6aKVTVjSsd0RGUOqY=
CLOB_PASS_PHRASE=d716e8a92d109cb0232cf7e46a74081a251e39c58b40aefe88845d9c83224d14

# =========================
# AI 模型配置
# =========================

# AI 供应商选择
# 可选值：openai / deepseek / qwen / custom
# 所有供应商都使用 OpenAI 兼容接口格式
AI_PROVIDER=custom

# AI 模型名称（对应所选供应商的模型）
# openai: gpt-4.1-mini, gpt-4o 等
# deepseek: deepseek-chat, deepseek-reasoner 等
# qwen: qwen-plus, qwen-max 等
AI_MODEL=gpt-4.1-mini

# AI 生成温度（0-1）
# 越低越确定性，越高越随机
# 交易分析建议用低温度（0.1-0.3）
AI_TEMPERATURE=0.2

# AI 请求超时时间（秒）
AI_TIMEOUT_SECONDS=60

# --- OpenAI 配置 ---
OPENAI_API_KEY=xxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1

# --- DeepSeek 配置 ---
DEEPSEEK_API_KEY=your_deepseek_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- 通义千问配置 ---
QWEN_API_KEY=your_qwen_key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# --- 自定义 OpenAI 兼容接口（如本地模型、其他供应商）---
CUSTOM_AI_API_KEY=sk-qtRlJEACmVmTWSQx0EI8cte5SAthIlmbznxZuCeYLpf2mRLfJRZ2qJ2tUgmeN8pM
CUSTOM_AI_BASE_URL=https://opencode.ai/zen/go/v1/chat/completions
CUSTOM_AI_MODEL=glm-5.1

# =========================
# 交易开关
# =========================

# 是否启用实盘交易
# false = 模拟盘（只记录信号日志，不提交真实订单）
# true = 实盘（满足风控条件后会真实下单）
# ⚠️ 首次使用务必设为 false，观察日志至少 3-7 天再开启
TRADE_ENABLED=false

# =========================
# 订单配置
# =========================

# 每笔订单金额（USDC）
# 建议从小金额开始（5-10），验证稳定后再增加
TRADE_AMOUNT_USDC=1

# 每日最大订单数量
# 防止 AI 频繁交易导致过度暴露
MAX_DAILY_ORDERS=5

# 每日最大累计交易金额（USDC）
# 超过此金额后当天不再下单
MAX_DAILY_SPEND_USDC=50

# 单个市场最大持仓金额（USDC）
# 防止在单一事件上过度集中
MAX_SINGLE_MARKET_POSITION_USDC=30

# =========================
# 策略配置
# =========================

# 市场扫描间隔（秒）
# 每隔多少秒执行一轮完整的市场扫描和分析
# 建议 60-300 秒，太频繁会浪费 AI 调用额度
SCAN_INTERVAL_SECONDS=30

# 每轮扫描的市场数量上限
# 从 Gamma API 拉取的活跃市场数量
MARKET_LIMIT=20

# 最低市场成交量要求（USDC）
# 低于此成交量的市场会被跳过，避免流动性不足
MIN_VOLUME_USDC=50000

# AI 最低预测概率
# AI 估计的事件概率低于此值时不交易
# 避免在极低概率事件上下注
MIN_AI_PROBABILITY=0.65

# AI 最低置信度要求（0-1）
# AI 对自己分析结果的信心程度
# 低于此值说明 AI 不确定，不应交易
MIN_AI_CONFIDENCE=0.70

# 最小 Edge（优势）要求
# edge = AI预测概率 - 市场当前价格
# 只有 edge 大于此值才有交易价值
# 0.15 表示 AI 认为真实概率比市场价格高 15% 以上
MIN_EDGE=0.15

# 最大允许盘口价差
# spread = best_ask - best_bid
# 价差过大说明流动性差，成交成本高
# 0.04 表示最多允许 4% 的价差
MAX_SPREAD=0.04

# =========================
# 市场过滤
# =========================

# 允许的市场类别（逗号分隔，留空表示不限制）
# 例如：crypto,tech,macro,sports,politics
ALLOW_CATEGORIES=

# 屏蔽关键词（逗号分隔）
# 市场标题包含这些词时自动跳过
# 用于过滤不适合自动交易的敏感话题
BLOCK_KEYWORDS=war,death,tragedy
