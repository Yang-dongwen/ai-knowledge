deploy/env/cloudflared/
deploy/env/quick-tunnel.url
# 兼容旧路径（迁移期）
deploy/app.env
deploy/app.env.local
deploy/.env
deploy/SECRETS_INVENTORY.env
deploy/.admin-once.txt

# 仅本地真实隐私 yml 不提交；application-ec2.yml 要提交（里面是变量）
**/application-local.yml
**/.env
!**/.env.example
!**/app.env.example
!**/app.env.local.example
!**/application-local.yml.example

