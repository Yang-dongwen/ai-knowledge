<view class="page page-with-bar">
  <!-- 格式分段 -->
  <view class="segment card" wx:if="{{!formatLocked}}">
    <view class="seg-tip muted">选择格式（创建后固定）</view>
    <view class="seg-row">
      <view class="seg-item {{format==='html'?'on':''}}" data-format="html" bindtap="pickFormat">富文本</view>
      <view class="seg-item {{format==='markdown'?'on':''}}" data-format="markdown" bindtap="pickFormat">Markdown</view>
    </view>
  </view>
  <view class="format-badge muted" wx:else>
    {{format === 'markdown' ? 'Markdown' : '富文本'}} · 创建后格式已锁定
  </view>

  <!-- 正文卡 -->
  <view class="card editor">
    <input
      class="title-input"
      placeholder="无标题"
      placeholder-class="ph"
      placeholder-style="color:#94a3b8;"
      value="{{title}}"
      bindinput="onTitle"
      maxlength="200"
    />
    <view class="rule" />

    <scroll-view scroll-x class="tools-scroll" enable-flex show-scrollbar="{{false}}">
      <view class="tool-btn" bindtap="pickImage">插图</view>
      <view class="tool-btn" bindtap="pickFile" wx:if="{{id}}">附件</view>
      <view class="tool-sep" wx:if="{{format==='html' || format==='markdown'}}"></view>
      <block wx:if="{{format==='html'}}">
        <view class="tool-btn" data-cmd="bold" bindtap="applyFmt">粗体</view>
        <view class="tool-btn" data-cmd="ul" bindtap="applyFmt">列表</view>
        <view class="tool-btn" data-cmd="quote" bindtap="applyFmt">引用</view>
        <view class="tool-btn" data-cmd="h2" bindtap="applyFmt">小标题</view>
      </block>
      <block wx:else>
        <view class="tool-btn" data-cmd="md-bold" bindtap="applyFmt">粗体</view>
        <view class="tool-btn" data-cmd="md-ul" bindtap="applyFmt">列表</view>
        <view class="tool-btn" data-cmd="md-quote" bindtap="applyFmt">引用</view>
      </block>
    </scroll-view>

    <textarea
      wx:if="{{format==='markdown'}}"
      class="content-input textarea"
      placeholder="开始书写…"
      placeholder-class="ph"
      placeholder-style="color:#94a3b8;"
      value="{{mdBody}}"
      maxlength="-1"
      auto-height
      adjust-position="{{true}}"
      cursor-spacing="24"
      show-confirm-bar="{{false}}"
      bindinput="onMdBody"
    />
    <textarea
      wx:else
      class="content-input textarea"
      placeholder="开始书写…（复杂排版可在 PC 完成）"
      placeholder-class="ph"
      placeholder-style="color:#94a3b8;"
      value="{{htmlContent}}"
      maxlength="-1"
      auto-height
      adjust-position="{{true}}"
      cursor-spacing="24"
      show-confirm-bar="{{false}}"
      bindinput="onHtmlContent"
    />
  </view>

  <!-- 属性 -->
  <view class="card props">
    <picker mode="selector" range="{{categories}}" range-key="name" value="{{categoryIndex}}" bindchange="onCategory">
      <view class="prop-row">
        <text class="prop-label">分类</text>
        <view class="prop-value">
          <text class="muted">{{categoryLabel}}</text>
          <text class="chevron">›</text>
        </view>
      </view>
    </picker>

    <view class="prop-block">
      <view class="prop-row no-border">
        <text class="prop-label">标签</text>
        <text class="tag-add" bindtap="createTag">+ 新建</text>
      </view>
      <view class="tag-chips" wx:if="{{allTags.length}}">
        <view
          class="chip {{item.selected ? 'on' : ''}}"
          wx:for="{{allTags}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="toggleTag"
        >#{{item.name}}</view>
      </view>
      <view class="muted tip" wx:else>暂无标签，点右上角新建</view>
    </view>

    <view class="prop-row">
      <text class="prop-label">置顶</text>
      <switch checked="{{pinned}}" bindchange="onPinned" color="#4f46e5" />
    </view>
  </view>

  <!-- 附件 -->
  <view class="card files" wx:if="{{id}}">
    <view class="files-head">
      <text class="prop-label">附件</text>
      <text class="tag-add" bindtap="pickFile">上传</text>
    </view>
    <view class="muted tip" wx:if="{{!files.length}}">暂无附件</view>
    <view class="file-row" wx:for="{{files}}" wx:key="id">
      <text class="fname">{{item.originalName}}</text>
      <text class="del" data-id="{{item.id}}" data-name="{{item.originalName}}" bindtap="removeFile">删除</text>
    </view>
  </view>

  <!-- 吸底操作 -->
  <view class="bottom-bar">
    <button class="btn btn-ghost btn-half" bindtap="onClear" disabled="{{saving}}">清空</button>
    <button class="btn btn-primary btn-half" loading="{{saving}}" disabled="{{saving}}" bindtap="onSave">
      {{id ? '保存' : '保存笔记'}}
    </button>
  </view>
</view>
