.page {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.segment {
  padding: 24rpx 24rpx 20rpx;
  margin-bottom: 20rpx;
}

.seg-tip {
  font-size: 24rpx;
  margin-bottom: 16rpx;
}

.seg-row {
  display: flex;
  background: #f1f5f9;
  border-radius: 14rpx;
  padding: 6rpx;
  gap: 6rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 12rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-2, #64748b);
}

.seg-item.on {
  background: #fff;
  color: var(--primary, #4f46e5);
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.06);
}

.format-badge {
  font-size: 22rpx;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.editor {
  padding: 8rpx 28rpx 28rpx;
  margin-bottom: 20rpx;
  min-height: 42vh;
}

.title-input {
  width: 100%;
  min-height: 72rpx;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.35;
  padding: 28rpx 0 18rpx;
  color: #0f172a !important;
  background-color: transparent !important;
  border: none;
}

.rule {
  height: 1rpx;
  background: var(--border, #eef2f7);
  margin-bottom: 16rpx;
}

.tools-scroll {
  white-space: nowrap;
  width: 100%;
  margin-bottom: 16rpx;
}

.tool-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  padding: 0 22rpx;
  margin-right: 12rpx;
  border-radius: 12rpx;
  background: #f1f5f9;
  font-size: 24rpx;
  font-weight: 600;
  color: #475569;
  flex-shrink: 0;
}

.tool-sep {
  display: inline-block;
  width: 1rpx;
  height: 28rpx;
  background: var(--border-strong, #e2e8f0);
  margin: 0 8rpx 0 0;
  vertical-align: middle;
}

.content-input {
  width: 100%;
  min-height: 480rpx;
  font-size: 30rpx;
  line-height: 1.7;
  color: #0f172a !important;
  background-color: #ffffff !important;
  border: none;
  padding: 8rpx 0 16rpx;
}

.props {
  padding: 8rpx 28rpx;
  margin-bottom: 20rpx;
}

.prop-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  border-bottom: 1rpx solid var(--border, #eef2f7);
}

.prop-row.no-border {
  border-bottom: none;
  min-height: 72rpx;
}

.prop-label {
  font-size: 28rpx;
  font-weight: 550;
  color: var(--text, #0f172a);
}

.prop-value {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
}

.prop-block {
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--border, #eef2f7);
}

.tag-add {
  font-size: 26rpx;
  font-weight: 650;
  color: var(--primary, #4f46e5);
}

.tag-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding-bottom: 12rpx;
}

.tip {
  font-size: 24rpx;
  padding-bottom: 16rpx;
}

.files {
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}

.files-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.file-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-top: 1rpx solid var(--border, #eef2f7);
  font-size: 26rpx;
}

.fname {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
  color: var(--text, #0f172a);
}

.del {
  color: var(--danger, #ef4444);
  font-weight: 600;
  font-size: 26rpx;
  flex-shrink: 0;
}
