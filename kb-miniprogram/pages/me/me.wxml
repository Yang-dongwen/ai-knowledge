<view class="page safe-bottom">
  <view class="profile card">
    <view class="avatar">{{avatarLetter}}</view>
    <view class="info">
      <view class="name">{{user.nickname || user.email || '未登录'}}</view>
      <view class="email muted">{{user.email || ''}}</view>
    </view>
  </view>

  <view class="card menu">
    <view class="menu-item" bindtap="goFolders">
      <view class="menu-left">
        <text class="menu-emoji">📁</text>
        <text>文件夹</text>
      </view>
      <text class="chevron">›</text>
    </view>
    <view class="menu-item" bindtap="goTags">
      <view class="menu-left">
        <text class="menu-emoji">🏷</text>
        <text>标签管理</text>
      </view>
      <text class="chevron">›</text>
    </view>
    <view class="menu-item" wx:if="{{!wxBound}}" bindtap="onBindWx">
      <view class="menu-left">
        <text class="menu-emoji">💬</text>
        <text>绑定微信登录</text>
      </view>
      <text class="chevron">{{wxBusy ? '…' : '›'}}</text>
    </view>
    <view class="menu-item" wx:else bindtap="onUnbindWx">
      <view class="menu-left">
        <text class="menu-emoji">💬</text>
        <text>解绑微信</text>
      </view>
      <text class="ok">已绑定</text>
    </view>
  </view>

  <view class="card section debug" wx:if="{{showDebug}}">
    <view class="section-title">开发调试</view>
    <view class="debug-row">
      <text>模拟微信 openid</text>
      <switch checked="{{wxMock}}" bindchange="onMockChange" color="#4f46e5" />
    </view>
    <view class="field-label">服务端地址</view>
    <input
      class="input"
      value="{{baseUrl}}"
      placeholder="https://www.dwcode.cloud"
      placeholder-class="ph"
      placeholder-style="color:#94a3b8;"
      bindinput="onBaseUrl"
    />
    <view class="row-actions">
      <button class="btn btn-ghost btn-sm" bindtap="resetBaseUrl">恢复默认</button>
      <button class="btn btn-secondary btn-sm" bindtap="saveBaseUrl">保存地址</button>
    </view>
    <view class="field-label mt">分享网页域名</view>
    <input
      class="input"
      value="{{shareWebOrigin}}"
      placeholder="可选 H5/PC 域名"
      placeholder-class="ph"
      placeholder-style="color:#94a3b8;"
      bindinput="onShareOrigin"
    />
    <view class="row-actions">
      <button class="btn btn-secondary btn-sm" bindtap="saveShareOrigin">保存</button>
    </view>
    <view class="hint muted">正式 release 不显示本区</view>
  </view>

  <view class="card section info">
    <view class="info-row">
      <text class="muted">版本</text>
      <text>{{version}}</text>
    </view>
    <view class="info-row">
      <text class="muted">环境</text>
      <text>{{envVersion}}</text>
    </view>
    <view class="info-row" wx:if="{{showDebug}}">
      <text class="muted">API</text>
      <text class="mono">{{baseUrl}}</text>
    </view>
  </view>

  <button class="btn btn-outline btn-block logout" bindtap="onLogout">退出登录</button>
</view>
