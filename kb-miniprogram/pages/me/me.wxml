<view class="page safe-bottom">
  <view class="profile card">
    <view class="avatar">{{avatarLetter}}</view>
    <view class="info">
      <view class="name">{{user.nickname || user.email || '未登录'}}</view>
      <view class="email muted">{{user.email || ''}}</view>
    </view>
  </view>

  <view class="card section">
    <view class="section-title">服务端地址</view>
    <input
      class="base-input"
      value="{{baseUrl}}"
      placeholder="http://127.0.0.1:8080"
      bindinput="onBaseUrl"
    />
    <view class="row-actions">
      <button class="btn-ghost sm" size="mini" bindtap="resetBaseUrl">恢复默认</button>
      <button class="btn-primary sm" size="mini" bindtap="saveBaseUrl">保存地址</button>
    </view>
    <view class="hint muted">本地调试请关闭开发者工具「校验合法域名」。真机请填局域网 IP 或 HTTPS 域名。</view>
  </view>

  <view class="card section">
    <view class="section-title">分享链接域名</view>
    <input
      class="base-input"
      value="{{shareWebOrigin}}"
      placeholder="http://192.168.x.x:5174 或 PC 站点"
      bindinput="onShareOrigin"
    />
    <view class="row-actions">
      <button class="btn-primary sm" size="mini" bindtap="saveShareOrigin">保存</button>
    </view>
    <view class="hint muted">用于拼接公开阅读链接（kb-mobile 或 PC /s/token）。留空则仅复制路径。</view>
  </view>

  <view class="card section">
    <view class="row">
      <text>版本</text>
      <text class="muted">{{version}}</text>
    </view>
    <view class="row">
      <text>当前环境</text>
      <text class="muted mono">{{baseUrl}}</text>
    </view>
  </view>

  <button class="btn-logout" bindtap="onLogout">退出登录</button>
</view>
