.page {
  padding: 24rpx;
}

.profile {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 20rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: #2563eb;
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.name {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.email {
  font-size: 24rpx;
}

.section {
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.base-input {
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 16rpx 18rpx;
  font-size: 26rpx;
  margin-bottom: 16rpx;
}

.row-actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.sm {
  margin: 0;
  padding: 0 20rpx;
}

.hint {
  font-size: 22rpx;
  line-height: 1.5;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
  padding: 12rpx 0;
  font-size: 26rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.row:last-child {
  border-bottom: none;
}

.mono {
  font-size: 22rpx;
  max-width: 60%;
  text-align: right;
  word-break: break-all;
}

.btn-logout {
  margin-top: 40rpx;
  background: #fff;
  color: #ef4444;
  border-radius: 16rpx;
  font-weight: 600;
  border: 1rpx solid #fecaca;
}

.btn-logout::after {
  border: none;
}
