.page-detail {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.body {
  padding: 32rpx 28rpx 36rpx;
  margin-bottom: 20rpx;
  min-height: 28vh;
}

.doc-title {
  font-size: 40rpx;
  font-weight: 750;
  line-height: 1.35;
  color: var(--text, #0f172a);
  margin-bottom: 16rpx;
}

.meta {
  font-size: 22rpx;
  margin-bottom: 16rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 4rpx;
  line-height: 1.6;
}

.fmt-pill.inline {
  display: inline-block;
  vertical-align: middle;
}

.tags {
  margin-bottom: 16rpx;
}

.rule {
  height: 1rpx;
  background: var(--border, #eef2f7);
  margin: 8rpx 0 28rpx;
}

.prose {
  color: #1e293b;
  width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.md-body {
  display: block;
  width: 100%;
  word-break: break-word;
  font-size: 30rpx;
  line-height: 1.75;
  color: #1e293b;
}

.share-panel {
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.share-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 8rpx;
}

.share-title {
  font-size: 30rpx;
  font-weight: 650;
  margin-bottom: 6rpx;
}

.hint {
  font-size: 22rpx;
  line-height: 1.45;
  max-width: 480rpx;
}

.share-url {
  font-size: 22rpx;
  word-break: break-all;
  background: #f8fafc;
  border: 1rpx solid var(--border, #eef2f7);
  border-radius: 12rpx;
  padding: 16rpx 18rpx;
  margin: 16rpx 0;
  line-height: 1.45;
}

.share-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.share-main {
  width: 100%;
}

.share-links {
  display: flex;
  justify-content: center;
  gap: 32rpx;
}

.link-btn {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary, #4f46e5);
  padding: 8rpx;
}

.link-btn.muted {
  color: var(--text-2, #64748b);
  font-weight: 500;
}

.files {
  padding: 8rpx 28rpx 12rpx;
  margin-bottom: 20rpx;
}

.files-title {
  font-weight: 650;
  font-size: 28rpx;
  padding: 20rpx 0 8rpx;
}

.file-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 0;
  border-top: 1rpx solid var(--border, #eef2f7);
  font-size: 28rpx;
}

.fname {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}

.btn-icon {
  flex: 0 0 140rpx;
  padding: 0 12rpx;
  font-size: 28rpx;
}

.btn-grow {
  flex: 1;
}

.danger-text {
  color: var(--danger, #ef4444) !important;
  background: var(--danger-soft, #fef2f2) !important;
}

.muted-3 {
  color: var(--text-3, #94a3b8);
}
