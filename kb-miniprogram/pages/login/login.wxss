.login-page {
  min-height: 100vh;
  padding: 72rpx 40rpx 48rpx;
  background:
    radial-gradient(ellipse 120% 80% at 50% -20%, rgba(79, 70, 229, 0.12), transparent 55%),
    var(--bg, #f6f7f9);
}

.hero {
  margin-bottom: 40rpx;
  text-align: center;
}

.logo-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 28rpx;
}

.logo {
  width: 100rpx;
  height: 100rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #6366f1 0%, #4f46e5 100%);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  font-size: 36rpx;
  letter-spacing: 1rpx;
  box-shadow: 0 12rpx 32rpx rgba(79, 70, 229, 0.28);
}

.title {
  font-size: 44rpx;
  font-weight: 750;
  color: var(--text, #0f172a);
  margin-bottom: 10rpx;
  letter-spacing: 1rpx;
}

.sub {
  font-size: 26rpx;
  color: var(--text-2, #64748b);
}

.form {
  padding: 36rpx 32rpx 40rpx;
}

.bind-tip {
  background: var(--primary-soft, #eef2ff);
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 28rpx;
}

.bind-tip-text {
  font-size: 24rpx;
  color: var(--primary, #4f46e5);
  line-height: 1.5;
}

.btn-wx {
  margin-bottom: 8rpx;
}

.divider-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 32rpx 0 28rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: var(--border, #eef2f7);
}

.divider-text {
  font-size: 22rpx;
  color: var(--text-3, #94a3b8);
  flex-shrink: 0;
}



.submit {
  margin-top: 8rpx;
}

.hint {
  margin-top: 28rpx;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.5;
}

.link {
  color: var(--primary, #4f46e5);
  font-weight: 600;
}

.muted-3 {
  color: var(--text-3, #94a3b8);
  font-size: 22rpx !important;
  margin-top: 12rpx !important;
}
