.login-page {
  min-height: 100vh;
  padding: 80rpx 40rpx 40rpx;
  background: linear-gradient(165deg, #0f172a 0%, #1e293b 42%, #f1f5f9 42%);
}

.hero {
  margin-bottom: 48rpx;
  color: #f8fafc;
}

.logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: #2563eb;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  font-size: 36rpx;
  margin-bottom: 24rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.sub {
  font-size: 26rpx;
  color: #94a3b8;
}

.form {
  padding: 36rpx 32rpx 40rpx;
}

.field {
  margin-bottom: 28rpx;
}

.label {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 12rpx;
}

.input {
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  padding: 20rpx 22rpx;
  font-size: 28rpx;
}

.submit {
  margin-top: 12rpx;
  height: 88rpx;
  line-height: 88rpx;
}

.hint {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
}
