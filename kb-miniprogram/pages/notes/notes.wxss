.page {
  padding-top: 20rpx;
}

.search-wrap {
  display: flex;
  align-items: center;
  padding: 0 20rpx 0 24rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
}

.search-icon {
  font-size: 28rpx;
  color: var(--text-3, #94a3b8);
  margin-right: 12rpx;
  font-weight: 300;
}

.search-input {
  flex: 1;
  height: 80rpx;
  min-height: 80rpx;
  font-size: 28rpx;
  line-height: 80rpx;
  color: #0f172a !important;
  background-color: transparent !important;
  border: none;
  padding: 0;
}

.search-go {
  font-size: 26rpx;
  font-weight: 650;
  color: var(--primary, #4f46e5);
  padding: 12rpx 8rpx 12rpx 16rpx;
  flex-shrink: 0;
}

.quick-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.quick-pill {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 72rpx;
  background: #fff;
  border-radius: var(--radius-md, 20rpx);
  border: 1rpx solid rgba(15, 23, 42, 0.04);
  box-shadow: var(--shadow-card, 0 2rpx 16rpx rgba(15, 23, 42, 0.04));
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text, #0f172a);
}

.quick-emoji {
  font-size: 28rpx;
}

.chips-scroll {
  white-space: nowrap;
  width: 100%;
  margin-bottom: 16rpx;
}

.chip .badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 8rpx;
  margin-left: 8rpx;
  border-radius: 999rpx;
  background: rgba(100, 116, 139, 0.15);
  font-size: 18rpx;
  font-weight: 700;
}

.chip.trash.on .badge {
  background: rgba(239, 68, 68, 0.15);
}

.meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 4rpx 16rpx;
}

.meta {
  font-size: 22rpx;
}

.meta-action {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--danger, #ef4444);
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.swipe-wrap {
  position: relative;
  overflow: hidden;
  border-radius: var(--radius-md, 20rpx);
}

.swipe-actions {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  z-index: 0;
}

.act {
  width: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
  font-weight: 650;
}

.act.pin {
  background: var(--primary, #4f46e5);
}

.act.del {
  background: var(--danger, #ef4444);
}

.swipe-front {
  position: relative;
  z-index: 1;
  transition: transform 0.22s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.swipe-front.open {
  transform: translateX(-256rpx);
}

.note-card {
  padding: 26rpx 28rpx 22rpx;
  background: #fff;
}

.note-card.deleted {
  opacity: 0.72;
}

.note-head {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.note-title-row {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.pin-mark {
  font-size: 24rpx;
  flex-shrink: 0;
}

.title-text {
  font-size: 30rpx;
  font-weight: 650;
  color: var(--text, #0f172a);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.35;
}

.snippet {
  font-size: 26rpx;
  line-height: 1.55;
  color: var(--text-2, #64748b);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  min-height: 80rpx;
  margin-bottom: 14rpx;
}

.foot {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 36rpx;
}

.foot-left {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
}

.cat-pill {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: #f1f5f9;
  color: #64748b;
  font-weight: 500;
}

.foot .tag {
  margin: 0;
}

.time {
  font-size: 20rpx;
  flex-shrink: 0;
  margin-left: auto;
}

.more {
  margin-top: 28rpx;
  text-align: center;
  padding-bottom: 16rpx;
}

.load-more {
  font-size: 26rpx;
  padding: 16rpx;
}
