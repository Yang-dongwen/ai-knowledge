<view class="page safe-bottom">
  <!-- 搜索 -->
  <view class="search-wrap card">
    <text class="search-icon">⌕</text>
    <input
      class="search-input"
      placeholder="{{trashMode ? '搜索回收站…' : '搜索标题或摘要…'}}"
      placeholder-class="ph"
      placeholder-style="color:#94a3b8;"
      value="{{keyword}}"
      confirm-type="search"
      bindinput="onKeyword"
      bindconfirm="onSearch"
    />
    <view class="search-go" bindtap="onSearch" wx:if="{{keyword}}">搜索</view>
  </view>

  <!-- 快捷入口 -->
  <view class="quick-row" wx:if="{{!trashMode}}">
    <view class="quick-pill" bindtap="goFolders">
      <text class="quick-emoji">📁</text>
      <text>文件夹</text>
    </view>
    <view class="quick-pill" bindtap="goTags">
      <text class="quick-emoji">🏷</text>
      <text>标签</text>
    </view>
  </view>

  <!-- 筛选 -->
  <scroll-view scroll-x class="chips-scroll" enable-flex enhanced show-scrollbar="{{false}}">
    <view class="chip {{!trashMode && !filterCategoryId && !filterUncategorized && !filterTagId ? 'on' : ''}}" bindtap="clearFilter">全部</view>
    <view
      class="chip {{!trashMode && filterUncategorized ? 'on' : ''}}"
      bindtap="filterUncategorized"
      wx:if="{{!trashMode}}"
    >未分类</view>
    <view
      wx:for="{{categories}}"
      wx:key="id"
      class="chip {{!trashMode && filterCategoryId === item.id ? 'on' : ''}}"
      data-id="{{item.id}}"
      bindtap="filterCat"
    >{{item.label || item.name}}</view>
    <view
      wx:for="{{tags}}"
      wx:key="id"
      class="chip {{!trashMode && filterTagId === item.id ? 'on' : ''}}"
      data-id="{{item.id}}"
      bindtap="filterTag"
    >#{{item.name}}</view>
    <view class="chip trash {{trashMode ? 'on' : ''}}" bindtap="toggleTrash">
      回收站
      <text class="badge" wx:if="{{trashCount}}">{{trashCount}}</text>
    </view>
  </scroll-view>

  <view class="meta-row">
    <text class="meta muted">{{trashMode ? '回收站' : filterLabel}} · {{total}} 条</text>
    <text wx:if="{{trashMode && total}}" class="meta-action" bindtap="emptyTrash">清空</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && !notes.length}}">
    <view class="empty-icon">{{trashMode ? '🗑' : '✨'}}</view>
    <view class="empty-title">{{trashMode ? '回收站是空的' : '还没有笔记'}}</view>
    <view class="empty-desc" wx:if="{{!trashMode}}">碎片想法先记下来，回头再整理</view>
    <button class="btn btn-primary empty-cta" wx:if="{{!trashMode}}" bindtap="goCreate">写一条</button>
  </view>

  <!-- 列表 -->
  <view class="list" wx:else>
    <view class="swipe-wrap" wx:for="{{notes}}" wx:key="id">
      <view class="swipe-actions" wx:if="{{!trashMode}}">
        <view class="act pin" data-id="{{item.id}}" data-pinned="{{item.pinned}}" catchtap="onTogglePin">
          {{item.pinned ? '取消' : '置顶'}}
        </view>
        <view class="act del" data-id="{{item.id}}" catchtap="onSoftDelete">删除</view>
      </view>
      <view
        class="note-card card swipe-front {{item.deleted || trashMode ? 'deleted' : ''}} {{openId === item.id ? 'open' : ''}}"
        data-id="{{item.id}}"
        bindtap="goDetail"
        bindlongpress="onNoteLongPress"
        bindtouchstart="onTouchStart"
        bindtouchend="onTouchEnd"
      >
        <view class="note-head">
          <view class="note-title-row">
            <text wx:if="{{item.pinned}}" class="pin-mark">📌</text>
            <text class="title-text">{{item.title || '未命名笔记'}}</text>
          </view>
          <text class="fmt-pill">{{item.formatLabel}}</text>
        </view>
        <view class="snippet">{{item.snippet || '暂无摘要'}}</view>
        <view class="foot">
          <view class="foot-left">
            <text class="cat-pill" wx:if="{{item.categoryName}}">{{item.categoryName}}</text>
            <text class="tag" wx:for="{{item.tags}}" wx:for-item="tg" wx:key="id">#{{tg.name}}</text>
          </view>
          <text class="time muted-3">{{item.updatedAtText}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="more" wx:if="{{hasMore && notes.length}}">
    <view class="load-more muted" bindtap="loadMore">
      {{loadingMore ? '加载中…' : '加载更多'}}
    </view>
  </view>
</view>
