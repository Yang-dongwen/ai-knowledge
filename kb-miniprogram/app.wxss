/**
 * 知识库 · 克制笔记风设计基线
 * 主色 indigo · 8pt 节奏 · 弱边框轻阴影
 */

page {
  --bg: #f6f7f9;
  --card: #ffffff;
  --text: #0f172a;
  --text-2: #64748b;
  --text-3: #94a3b8;
  --primary: #4f46e5;
  --primary-soft: #eef2ff;
  --danger: #ef4444;
  --danger-soft: #fef2f2;
  --success: #16a34a;
  --border: #eef2f7;
  --border-strong: #e2e8f0;
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --shadow-card: 0 2rpx 16rpx rgba(15, 23, 42, 0.045);
  --page-x: 32rpx;

  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

/* 原生 input/textarea 不支持 CSS 变量，必须用实色，否则真机字色可能消失 */
input,
textarea {
  color: #0f172a !important;
  background-color: #ffffff;
  caret-color: #4f46e5;
}

/* —— 布局 —— */
.page {
  min-height: 100vh;
  padding: 24rpx var(--page-x) 40rpx;
}

.safe-bottom {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.page-with-bar {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* —— 卡片 —— */
.card {
  background: var(--card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  border: 1rpx solid rgba(15, 23, 42, 0.03);
}

/* —— 文字 —— */
.muted {
  color: var(--text-2);
}

.muted-3 {
  color: var(--text-3);
}

.section-title {
  font-size: 26rpx;
  font-weight: 650;
  color: var(--text);
  margin-bottom: 16rpx;
}

.divider {
  height: 1rpx;
  background: var(--border);
  margin: 0;
}

/* —— 按钮体系 —— */
button {
  margin: 0;
  padding: 0;
  font-weight: 600;
  line-height: 1.2;
  background: transparent;
}

button::after {
  border: none !important;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 32rpx;
  border-radius: var(--radius-md);
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.btn-primary {
  background: var(--primary);
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(79, 70, 229, 0.28);
}

.btn-primary[disabled],
.btn-primary.btn-disabled {
  opacity: 0.5;
  box-shadow: none;
}

.btn-secondary {
  background: var(--primary-soft);
  color: var(--primary);
}

.btn-ghost {
  background: #f1f5f9;
  color: var(--text);
}

.btn-outline {
  background: #ffffff;
  color: var(--text);
  border: 1rpx solid var(--border-strong);
}

.btn-danger {
  background: var(--danger);
  color: #ffffff;
}

.btn-danger-soft {
  background: var(--danger-soft);
  color: var(--danger);
}

.btn-text {
  background: transparent;
  color: var(--primary);
  height: auto;
  padding: 12rpx 8rpx;
  font-size: 28rpx;
  box-shadow: none;
}

.btn-block {
  width: 100%;
}

.btn-sm {
  height: 64rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  border-radius: var(--radius-sm);
}

.btn-half {
  flex: 1;
}

/* —— 输入（全部实色，兼容真机原生组件） —— */
.field {
  margin-bottom: 24rpx;
}

.field-label {
  display: block;
  font-size: 24rpx;
  font-weight: 550;
  color: #64748b;
  margin-bottom: 12rpx;
}

.input,
.textarea {
  width: 100%;
  min-height: 80rpx;
  background-color: #f8fafc !important;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: #0f172a !important;
  caret-color: #4f46e5;
}

.ph {
  color: #94a3b8 !important;
}

/* —— 芯片 —— */
.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  padding: 0 22rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #eef1f6;
  font-size: 24rpx;
  color: #475569;
  font-weight: 500;
  flex-shrink: 0;
}

.chip.on,
.chip-on {
  background: var(--primary-soft);
  color: var(--primary);
  font-weight: 650;
}

.chip.trash.on {
  background: var(--danger-soft);
  color: var(--danger);
}

/* —— 标签 pill —— */
.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  margin-right: 8rpx;
  margin-bottom: 6rpx;
  font-size: 20rpx;
  color: var(--primary);
  background: var(--primary-soft);
  border-radius: 999rpx;
  font-weight: 550;
}

/* —— 空状态 —— */
.empty-state {
  padding: 100rpx 40rpx 80rpx;
  text-align: center;
}

.empty-icon {
  font-size: 72rpx;
  line-height: 1.2;
  margin-bottom: 20rpx;
  opacity: 0.9;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 650;
  color: var(--text);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.55;
  margin-bottom: 36rpx;
}

.empty-cta {
  width: 280rpx;
  margin: 0 auto;
}

/* 兼容旧 class */
.empty {
  padding: 100rpx 40rpx;
  text-align: center;
  color: var(--text-2);
}

/* —— 列表行 —— */
.list-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 20rpx 4rpx;
  border-bottom: 1rpx solid var(--border);
}

.list-row:last-child {
  border-bottom: none;
}

.chevron {
  color: var(--text-3);
  font-size: 28rpx;
  font-weight: 400;
}

/* —— 底部弹层 —— */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.38);
  z-index: 100;
}

.sheet {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 101;
  padding: 16rpx 28rpx 28rpx;
  border-radius: var(--radius-lg);
  background: var(--card);
  box-shadow: 0 12rpx 48rpx rgba(15, 23, 42, 0.12);
}

.sheet-handle {
  width: 64rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #e2e8f0;
  margin: 8rpx auto 20rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
  text-align: center;
}

.sheet-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

/* —— 固定底栏 —— */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  gap: 16rpx;
  padding: 16rpx var(--page-x) calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(12px);
  border-top: 1rpx solid var(--border);
  box-shadow: 0 -4rpx 24rpx rgba(15, 23, 42, 0.04);
}

/* —— 格式 pill —— */
.fmt-pill {
  font-size: 18rpx;
  font-weight: 650;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: var(--primary-soft);
  color: var(--primary);
  flex-shrink: 0;
}

.loading-text {
  text-align: center;
  padding: 48rpx;
  font-size: 26rpx;
  color: var(--text-3);
}
