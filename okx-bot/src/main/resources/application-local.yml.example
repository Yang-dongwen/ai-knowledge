# 复制为 application-local.yml（gitignore）
# 本文件只覆盖本机库/密钥/路径。开关在 config/*.yml。
# 启动加载顺序：application.yml → config/{auth,pay,ai,platform}.yml → 本文件

server:
  port: 8080

spring:
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://localhost:3306/okx_bot?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
    username: root
    password: 123456

auth:
  jwt:
    secret: okx-bot-jwt-secret-change-me-in-production-2026-secure-key
  admin:
    email: admin@okx-bot.local
    password: Admin@123456

pay:
  public-base-url: http://127.0.0.1:8080
  mock-enabled: true
  stripe:
    publishable-key: pk_test_替换
    secret-key: sk_test_替换
    webhook-secret: whsec_替换

ai:
  providers:
    nvidia:
      api-key: ""
  embedding:
    api-key: ""
  vector-store:
    host: ""
    api-key: ""

storage:
  provider: r2
  env-prefix: local
  local:
    root: ./data/_objects
  scratch:
    root: ./data/_scratch
  r2:
    account-id: ""
    bucket: ""
    access-key-id: ""
    secret-access-key: ""
    endpoint: ""

video:
  work-dir: ./data/video
  yt-dlp-path: yt-dlp
  ffmpeg-path: ffmpeg
  whisper:
    base-url: http://127.0.0.1:8000
    managed:
      enabled: true
      working-dir: ./whisper-service

aigen:
  work-dir: ./data/aigen
  remotion:
    manage-process: true
    project-dir: ../aigen-remotion

imggen:
  work-dir: ./data/imggen

logging:
  level:
    com.dwcode.okxbot: DEBUG
